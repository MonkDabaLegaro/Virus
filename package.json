{
  "name": "malware-security-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first educational malware analysis laboratory.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c auto \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @malware-lab/api",
    "dev:web": "npm run dev --workspace @malware-lab/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2"
  }
}
